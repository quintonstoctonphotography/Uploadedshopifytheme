<!-- Footer Section -->
<footer data-section="{{ section.id }}">
    <div class="footer-content">
        <div class="footer-logo">
            <span class="white">{{ settings.business_name | split: ' ' | first }}</span>
            <span class="red">{{ settings.business_name | split: ' ' | last }}</span>
        </div>
        
        <nav class="footer-nav">
            <a href="/pages/about">About</a>
            <a href="/pages/mission">Mission</a>
            <a href="/pages/contact">Contact</a>
            <a href="/pages/privacy">Privacy</a>
            <a href="/pages/terms">Terms</a>
            <a href="/pages/refund">Refund Policy</a>
        </nav>
        
        {% render 'footer-social' %}
        
        <div class="footer-info">
            <p>&copy; {% now 'year' %} {{ settings.business_name }}. All rights reserved.</p>
            <p>{{ settings.business_city }}, {{ settings.business_state }} | {{ settings.business_phone }} | {{ settings.business_email }}</p>
        </div>
    </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "target": "section",
  "settings": []
}
{% endschema %}
