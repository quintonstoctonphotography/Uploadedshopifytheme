<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_scheme_1_bg.rgb }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <meta name="keywords" content="photographer Glasgow Kentucky, wedding photography, branding, logo design, Lightroom presets, portrait photography">
    <meta name="author" content="Quinton Stocton Photography">
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{% if page_title %}{{ page_title }}{% else %}{{ shop.name }}{% endif %}">
    <meta property="og:description" content="{{ page_description | default: 'Professional photography and design services in Glasgow, Kentucky' | escape }}">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Quinton Stocton Photography">
    <meta name="twitter:description" content="Professional photography and design services in Glasgow, KY">

    {% render 'theme-styles-variables' %}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "LocalBusiness",
      "name": "{{ settings.business_name | default: 'Quinton Stocton Photography' }}",
      "description": "{{ settings.business_description | default: 'Professional photography and design services featuring wedding photography, branding, digital design, and Lightroom presets.' }}",
      "image": "{{ settings.business_image | image_url }}",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "{{ settings.business_city | default: 'Glasgow' }}",
        "addressRegion": "{{ settings.business_state | default: 'KY' }}",
        "postalCode": "{{ settings.business_zip | default: '42141' }}",
        "addressCountry": "US"
      },
      "telephone": "{{ settings.business_phone | default: '+1-270-283-7950' }}",
      "email": "{{ settings.business_email | default: 'customersupport@quintonstoctonphotography.com' }}",
      "url": "{{ shop.url }}",
      "priceRange": "{{ settings.business_price_range | default: '$$$' }}",
      "areaServed": ["KY", "TN", "US"],
      "serviceType": ["Photography", "Branding", "Design"]
    }
    </script>
  </head>

  <body class="color-{{ settings.color_scheme }}">
    {% section 'header' %}

    <main role="main" id="MainContent" class="content-for-layout">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
