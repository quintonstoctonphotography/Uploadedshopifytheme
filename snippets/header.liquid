<header class="site-header">
  <div class="header-content">
    <div class="logo">
      <a href="/">{{ shop.name }}</a>
    </div>
    
    <nav class="main-nav">
      <ul>
        {% for link in linklists.main-menu.links %}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
    
    <div class="header-icons">
      <a href="/cart" class="cart-icon">
        Cart ({{ cart.item_count }})
      </a>
    </div>
  </div>
</header>
