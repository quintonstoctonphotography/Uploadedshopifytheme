<h1>Welcome to {{ shop.name }}</h1>
<p>This is the home page of your Shopify theme.</p>

{% if shop.products_count > 0 %}
  <h2>Featured Products</h2>
  <div class="products-grid">
    {% for product in shop.products limit: 12 %}
      <div class="product-card">
        <a href="{{ product.url }}">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: '300x300' }}" alt="{{ product.featured_image.alt | escape }}">
          {% endif %}
          <h3>{{ product.title }}</h3>
          <p class="price">{{ product.price | money }}</p>
        </a>
      </div>
    {% endfor %}
  </div>
{% endif %}
