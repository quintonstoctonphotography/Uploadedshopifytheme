{% section 'page-header' %}

<div class="about-container">
  <!-- Hero Section -->
  <section class="about-hero">
    <div class="hero-content">
      <h1 class="hero-title">About Quinton Stocton Photography</h1>
      <p class="hero-subtitle">Capturing moments, preserving memories, and telling your story through the lens</p>
    </div>
  </section>

  <!-- Story Section -->
  <section class="about-story">
    <div class="story-grid">
      <div class="story-image">
        <img src="{{ 'about-hero.jpg' | asset_url }}" alt="Quinton Stocton Photography" loading="lazy">
      </div>
      <div class="story-content">
        <h2>My Journey in Photography</h2>
        <p>With over a decade of experience in professional photography, I've dedicated myself to capturing the essence of life's most meaningful moments. My passion for visual storytelling began as a simple hobby and has evolved into a thriving career helping clients preserve their most cherished memories.</p>
        <p>Every photograph I take is an opportunity to connect with my subjects, understand their vision, and deliver images that exceed expectations. Whether it's a wedding, portrait session, corporate event, or creative project, I approach each assignment with the same level of dedication and artistic excellence.</p>
        <h3>What Drives Me</h3>
        <ul class="story-list">
          <li><strong>Authenticity:</strong> I capture genuine emotions and moments, not staged perfection</li>
          <li><strong>Technical Excellence:</strong> Mastery of lighting, composition, and post-processing techniques</li>
          <li><strong>Client Satisfaction:</strong> Your vision and expectations are my top priority</li>
          <li><strong>Creative Innovation:</strong> Continuously exploring new styles and techniques</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="about-services">
    <h2>Services & Specialties</h2>
    <div class="services-grid">
      <div class="service-card">
        <div class="service-icon">📸</div>
        <h3>Weddings</h3>
        <p>From engagement sessions to the big day, I capture the love, joy, and details that make your wedding unforgettable</p>
      </div>
      <div class="service-card">
        <div class="service-icon">👤</div>
        <h3>Portraits</h3>
        <p>Professional headshots, family portraits, and individual sessions that showcase your best self</p>
      </div>
      <div class="service-card">
        <div class="service-icon">🎉</div>
        <h3>Events</h3>
        <p>Corporate events, celebrations, and special occasions documented with a creative eye</p>
      </div>
      <div class="service-card">
        <div class="service-icon">📱</div>
        <h3>Commercial</h3>
        <p>Product photography, brand storytelling, and content creation for businesses and entrepreneurs</p>
      </div>
    </div>
  </section>

  <!-- Philosophy Section -->
  <section class="about-philosophy">
    <h2>My Photography Philosophy</h2>
    <div class="philosophy-content">
      <p>Photography is more than just pointing a camera and clicking a button—it's about understanding light, emotion, and the story waiting to be told. I believe in creating a comfortable environment where my clients feel relaxed and natural, resulting in authentic photographs that resonate for a lifetime.</p>
      <p>Every project is an opportunity to collaborate, innovate, and push creative boundaries. I stay committed to continuous learning, investing in the latest equipment and techniques while maintaining a timeless approach to storytelling.</p>
    </div>
  </section>

  <!-- Skills & Equipment Section -->
  <section class="about-skills">
    <div class="skills-grid">
      <div class="skills-column">
        <h3>Expertise</h3>
        <ul>
          <li>Wedding Photography</li>
          <li>Portrait Sessions</li>
          <li>Event Coverage</li>
          <li>Product Photography</li>
          <li>Lifestyle Imagery</li>
          <li>Post-Processing & Editing</li>
        </ul>
      </div>
      <div class="skills-column">
        <h3>Specialties</h3>
        <ul>
          <li>Candid Moments</li>
          <li>Natural Lighting</li>
          <li>Outdoor Sessions</li>
          <li>Studio Photography</li>
          <li>High-Volume Events</li>
          <li>Creative Direction</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="about-cta">
    <h2>Ready to Work Together?</h2>
    <p>I'd love to hear about your project and discuss how I can help bring your vision to life.</p>
    <div class="cta-buttons">
      <a href="{{ routes.root_url }}contact" class="button button-primary">Get in Touch</a>
      <a href="{{ routes.root_url }}portfolio" class="button button-secondary">View Portfolio</a>
    </div>
  </section>
</div>

<style>
  .about-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Hero Section */
  .about-hero {
    padding: 6rem 2rem;
    text-align: center;
    background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
    margin-bottom: 4rem;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    margin: 0 0 1rem 0;
    color: #1a1a1a;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: #555;
    margin: 0;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Story Section */
  .about-story {
    margin-bottom: 4rem;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .story-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .story-content h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: #1a1a1a;
  }

  .story-content p {
    font-size: 1rem;
    line-height: 1.8;
    color: #555;
    margin-bottom: 1.5rem;
  }

  .story-content h3 {
    font-size: 1.3rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #1a1a1a;
  }

  .story-list {
    list-style: none;
    padding: 0;
  }

  .story-list li {
    padding: 0.75rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: #555;
  }

  .story-list li:before {
    content: "→";
    position: absolute;
    left: 0;
    color: #d4af37;
    font-weight: bold;
  }

  /* Services Section */
  .about-services {
    margin-bottom: 4rem;
    padding: 3rem 2rem;
    background: #f9f9f9;
    border-radius: 8px;
  }

  .about-services h2 {
    font-size: 2rem;
    text-align: center;
    margin-bottom: 3rem;
    color: #1a1a1a;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .service-card {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
  }

  .service-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .service-card h3 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    color: #1a1a1a;
  }

  .service-card p {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.6;
  }

  /* Philosophy Section */
  .about-philosophy {
    margin-bottom: 4rem;
    padding: 3rem 2rem;
    border-left: 4px solid #d4af37;
  }

  .about-philosophy h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: #1a1a1a;
  }

  .philosophy-content p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #555;
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  /* Skills Section */
  .about-skills {
    margin-bottom: 4rem;
    padding: 3rem 2rem;
    background: #f9f9f9;
    border-radius: 8px;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .skills-column h3 {
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
    color: #1a1a1a;
    border-bottom: 2px solid #d4af37;
    padding-bottom: 0.5rem;
  }

  .skills-column ul {
    list-style: none;
    padding: 0;
  }

  .skills-column li {
    padding: 0.5rem 0;
    color: #555;
    position: relative;
    padding-left: 1.5rem;
  }

  .skills-column li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #d4af37;
    font-weight: bold;
  }

  /* CTA Section */
  .about-cta {
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, #1a1a1a 0%, #333 100%);
    color: white;
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  .about-cta h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: white;
  }

  .about-cta p {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    color: #ddd;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .button-primary {
    background: #d4af37;
    color: #1a1a1a;
  }

  .button-primary:hover {
    background: #c9a02d;
    transform: translateY(-2px);
  }

  .button-secondary {
    border: 2px solid #d4af37;
    color: #d4af37;
    background: transparent;
  }

  .button-secondary:hover {
    background: #d4af37;
    color: #1a1a1a;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .story-grid,
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .about-hero {
      padding: 3rem 1rem;
    }

    .hero-title {
      font-size: 2rem;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .button {
      width: 100%;
      text-align: center;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% section 'page-footer' %}
